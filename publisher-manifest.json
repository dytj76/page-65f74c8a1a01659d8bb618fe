ght:1px solid rgba(58,31,36,.12)}\n.plan.featured .plan-name{border-right-color:rgba(216,194,173,.25)}\n.plan-name h3{font-size:22px;font-weight:500;margin-bottom:6px}\n.plan-name .price{font-size:15px;opacity:.85}\n.plan-name .annual{font-size:13px;margin-top:8px;font-style:italic;opacity:.8}\n.plan-features{padding:24px 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px 20px;align-content:center}\n.plan-features div{font-size:14px;padding-left:16px;position:relative}\n.plan-features div::before{content:\"·\";position:absolute;left:2px;top:0;color:#a64a59;font-weight:700}\n.plan.featured .plan-features div::before{color:#d8c2ad}\n.plan-cta{padding:24px 28px 24px 0;display:flex;align-items:center;justify-content:flex-end;border-left:1px solid rgba(58,31,36,.12)}\n.plan.featured .plan-cta{border-left-color:rgba(216,194,173,.25)}\n.plan-cta a{display:inline-block;padding:12px 22px;border:1px solid currentColor;font-size:14px;letter-spacing:.1em}\n.plan-cta a:hover{background:currentColor;color:#fbf5ea}\n.plan.featured .plan-cta a:hover{background:#fbf5ea;color:#5c1622}\n\n/* FAQ 按主题分组 */\n.faq-group{margin-bottom:36px}\n.faq-group h3{font-size:20px;font-weight:500;color:#7a1f2b;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid rgba(122,31,43,.2)}\n.faq-group h3 .tag{display:inline-block;font-size:12px;letter-spacing:.2em;color:#a64a59;margin-left:10px;font-style:italic;font-family:Georgia,serif}\ndetails.faq{background:#fbf5ea;border:1px solid rgba(122,31,43,.18);margin-bottom:10px;position:relative}\ndetails.faq::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:4px;background:#a64a59}\ndetails.faq[open]{background:#fff8eb}\ndetails.faq summary{padding:14px 22px 14px 28px;cursor:pointer;font-size:15px;color:#3a1f24;list-style:none;display:flex;justify-content:space-between;gap:16px}\ndetails.faq summary::-webkit-details-marker{display:none}\ndetails.faq summary::after{content:\"+\";font-family:Georgia,serif;color:#7a1f2b;font-size:18px;line-height:1}\ndetails.faq[open] summary::after{content:\"−\"}\ndetails.faq .a{padding:0 22px 18px 28px;font-size:14px;color:#3a1f24}\ndetails.faq .a p{margin-bottom:8px}\n\n/* 客户端列表 */\n.clients-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}\n.client{padding:20px 22px 20px 28px;background:#fbf5ea;border:1px solid rgba(122,31,43,.18);position:relative}\n.client::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:4px;background:#7a1f2b}\n.client h4{font-size:17px;font-weight:500;margin-bottom:4px}\n.client .sys{font-size:12px;color:#a64a59;letter-spacing:.18em;text-transform:uppercase;margin-bottom:8px}\n.client p{font-size:13.5px;color:#3a1f24}\n\n/* 使用步骤 */\n.steps{counter-reset:step;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px;margin-top:18px}\n.step{background:#fbf5ea;padding:26px 24px 24px 32px;position:relative;border:1px solid rgba(122,31,43,.18)}\n.step::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:5px;background:#7a1f2b}\n.step .n{counter-increment:step;font-family:Georgia,serif;font-style:italic;color:#a64a59;font-size:13px;letter-spacing:.18em}\n.step .n::before{content:counter(step,decimal-leading-zero) \" · \"}\n.step h4{font-size:17px;font-weight:500;margin:6px 0 10px}\n.step p{font-size:14px}\n\n/* 底部固定式文字导航 */\n.bottom-nav{position:sticky;bottom:0;left:0;right:0;background:#3a1f24;color:#f4ece1;border-top:1px solid #5c1622;z-index:50}\n.bottom-nav .wrap{display:flex;align-items:center;gap:6px;padding:14px 28px;flex-wrap:wrap}\n.bottom-nav .label{font-size:12px;letter-spacing:.3em;opacity:.7;margin-right:14px;text-transform:uppercase;font-style:italic;font-family:Georgia,serif}\n.bottom-nav a{color:#f4ece1;font-size:14px;padding:6px 10px;border:none;letter-spacing:.04em}\n.bottom-nav a:hover{color:#d8c2ad;border:none}\n.bottom-nav .spacer{flex:1}\n.bottom-nav .cta{padding:6px 14px;border:1px solid #d8c2ad;font-size:13px;letter-spacing:.12em}\n.bottom-nav .cta:hover{background:#d8c2ad;color:#3a1f24}\n\nfooter.foot{padding:48px 0 120px;background:#2a131a;color:#d8c2ad;font-size:13px;text-align:center}\nfooter.foot .small{opacity:.7;margin-top:10px;font-size:12px}\n\n/* 响应式 */\n@media (max-width:820px){.band--a{padding-top:64px;padding-bottom:64px}\n  .plan{grid-template-columns:1fr}\n  .plan-name,.plan-features,.plan-cta{border:none;padding:18px 22px;border-bottom:1px solid rgba(58,31,36,.1)}\n  .plan-name{border-right:none}\n  .plan-cta{justify-content:flex-start}\n  .bottom-nav .label{display:none}\n  .bottom-nav .wrap{padding:10px 18px}\n  .bottom-nav a{padding:5px 8px;font-size:13px}\n  .block-title h2{font-size:26px}}\n</style><main>\n\n\n<section class=\"hero\" aria-label=\"首屏\">\n  <div class=\"band band--a\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">编年档案 · MMXXVI</p>\n      <h1>夜煞(HiccupPort) · 夜煞<span class=\"en\">HiccupPort — A Nocturnal Beacon</span></h1>\n    </div>\n  </div>\n  <div class=\"band band--b\">\n    <div class=\"wrap\">\n      <p>这是一处面向深夜出航者的网络代理服务。它不承诺风平浪静，只是把灯挂得再稳一些，让你在风暴过境时仍能找到一块可以停泊的版面。</p>\n    </div>\n  </div>\n  <div class=\"band band--c\">\n    <div class=\"wrap\">\n      <span>创立于跨境协作的缝隙</span>\n      <span>面向夜间工作者</span>\n      <span>以文字与节律为锚</span>\n      <span>酒红与象牙白的版式</span>\n      <span>长期记录,而非短期爆款</span>\n    </div>\n  </div>\n  <div class=\"band band--d\">\n    <div class=\"wrap\">\n      \"港是不动的,动的是船。\"\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"prologue\">\n  <div class=\"wrap\">\n    <div class=\"block-title\">\n      <span class=\"num\">§ 一</span>\n      <h2>缘起:为什么叫夜煞</h2>\n      <span class=\"line\"></span>\n    </div>\n    <div class=\"column\">\n      <p class=\"first\">夜煞,听起来像是一种夜间出没的小型猛禽。事实上,它更接近一个比喻:很多真正的工作,只在屏幕亮起的那几个小时里发生。一个写作者要赶在凌晨四点交稿,一个研究员要在不同地区的资料库里翻找,一个跨境团队的成员要在无人注意时同步进度。他们的共同点,是需要一条安静的、不会在关键时刻掉链子的线路,而不是一段惊艳的演示。</p>\n      <p>HiccupPort 是它的英文写法。Hiccup 指轻微的停顿、打嗝,在这里被当作一种隐喻:好的服务,应该让你几乎忘记它的存在。它只在某些极短暂的间隙里被想起,例如一次跨海视频会议,一个被远程服务器拒绝的连接请求,一份必须在截止前上传的文件。Port 既是网络意义上的端口,也是港湾意义上的港口。</p>\n      <div class=\"pull\">我们不接受把夜煞宣传成一台冲浪神器。它是一块被仔细校准过的夜间地标,亮在大多数人不看天色的时刻。</div>\n      <p>这一份页面,就是夜煞的说明书。它不打算用华丽的形容词,而是按一位专栏作者的节奏,把它的来路、它的条款、它适合谁、不适合谁,逐段写下。</p>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"audience\">\n  <div class=\"wrap\">\n    <div class=\"block-title\">\n      <span class=\"num\">§ 二</span>\n      <h2>谁会停留,谁会离开</h2>\n      <span class=\"line\"></span>\n    </div>\n    <div class=\"cards\">\n      <article class=\"card\">\n        <p class=\"meta\">适合</p>\n        <h3>把深夜当作白天的人</h3>\n        <p>写作者、独立研究员、时区错位的开发者、跨境运营者,他们的工作节律跨越 24 小时,需要的是稳定而不是速度的口号。</p>\n        <ul>\n          <li>长时段后台同步</li>\n          <li>低峰期大文件传输</li>\n          <li>不被打断的写作节奏</li>\n        </ul>\n      </article>\n      <article class=\"card tone-b\">\n        <p class=\"meta\">适合</p>\n        <h3>对版式有洁癖的读者</h3>\n        <p>你更看重一份说明书的语气、字距和留白,而不是一段评测视频里的跑分。这一页的设计,正是写给这样的眼睛。</p>\n        <ul>\n          <li>耐心的中长阅读</li>\n          <li>不要求即时互动</li>\n          <li>愿意自己翻 FAQ</li>\n        </ul>\n      </article>\n      <article class=\"card tone-c\">\n        <p class=\"meta\">未必适合</p>\n        <h3>追求极限峰值的用户</h3>\n        <p>如果你需要的是 24 小时满载的下载场景,或者把代理当作游戏加速器的主要选择,那么夜煞的设计初衷与你的期待并不一致。</p>\n        <ul>\n          <li>长时间高码率串流</li>\n          <li>多人同时重度下载</li>\n          <li>对单次延迟极度敏感</li>\n        </ul>\n      </article>\n      <article class=\"card tone-d\">\n        <p class=\"meta\">未必适合</p>\n        <h3>不愿阅读条款的人</h3>\n        <p>夜煞不假设用户是默认同意的。它把所有能写清楚的事情写在 FAQ 里,包括计费、续费、停服与争议处理。如果你不愿读条款,这里会让你不自在。</p>\n        <ul>\n          <li>不接受按月计费</li>\n          <li>跳过服务条款</li>\n          <li>不愿填写使用场景说明</li>\n        </ul>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"howto\">\n  <div class=\"wrap\">\n    <div class=\"block-title\">\n      <span class=\"num\">§ 三</span>\n      <h2>从下单到挂上锚,只需五步</h2>\n      <span class=\"line\"></span>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <span class=\"n\">章节</span>\n        <h4>挑选一份套餐</h4>\n        <p>在下方的阶梯式套餐中找到与你的月流量、设备数量最接近的一档。每一档都对应一个真实的预算区间,而不是某种\"入门体验\"。</p>\n      </div>\n      <div class=\"step\">\n        <span class=\"n\">章节</span>\n        <h4>提交一份使用场景</h4>\n        <p>在订单备注里简述你的工作内容,例如\"跨境写稿+日常资料检索\"。这不是审查,而是让夜煞在开通线路时给出更贴合的默认建议。</p>\n      </div>\n      <div class=\"step\">\n        <span class=\"n\">章节</span>\n        <h4>收到节点与凭证</h4>\n        <p>开通后,你会在账户内看到分组的节点列表、订阅链接和一份适用于常见客户端的配置示例。凭证仅显示一次,请妥善保存。</p>\n      </div>\n      <div class=\"step\">\n        <span class=\"n\">章节</span>\n        <h4>选择客户端并导入</h4>\n        <p>下方列出常见客户端的覆盖范围与特点。请按你常用的设备,选择对应的导入方式,不必一次装齐所有客户端。</p>\n      </div>\n      <div class=\"step\">\n        <span class=\"n\">章节</span>\n        <h4>把窗口调到夜间模式</h4>\n        <p>这不是建议,而是邀请。当你在凌晨三点还能稳定地打开一份文件,这才是夜煞真正想达到的状态。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"block-title\">\n      <span class=\"num\">§ 四</span>\n      <h2>套餐:三档,每一档都是一段完整的驻留</h2>\n      <span class=\"line\"></span>\n    </div>\n    <p>夜煞不设\"试用体验\"档位。短期使用请直接选择基础版按月支付,长期使用推荐按年付费以减少续费打扰。以下价格与权益以本页为准,所有套餐均不含承诺期之外的免费时长。</p>\n\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <div class=\"plan-name\">\n          <h3>基础版</h3>\n          <div class=\"price\">¥15 / 月</div>\n          <div class=\"annual\">按年付仅需 ¥150 / 年</div>\n        </div>\n        <div class=\"plan-features\">\n          <div>每月 100GB 流量额度</div>\n          <div>支持 3 台设备同时在线</div>\n          <div>解锁基础流媒体</div>\n          <div>普通线路节点池</div>\n          <div>工作日邮件工单支持</div>\n        </div>\n        <div class=\"plan-cta\">\n          <a href=\"#\">按月订阅</a>\n        </div>\n      </article>\n\n      <article class=\"plan featured\">\n        <div class=\"plan-name\">\n          <span class=\"plan-tag\">编 辑 推 荐</span>\n          <h3>旗舰版</h3>\n          <div class=\"price\">¥35 / 月</div>\n          <div class=\"annual\">按年付仅需 ¥350 / 年</div>\n        </div>\n        <div class=\"plan-features\">\n          <div>每月 300GB 流量额度</div>\n          <div>支持 5 台设备同时在线</div>\n          <div>全节点原生流媒体解锁</div>\n          <div>IPLC 专线游戏加速优化</div>\n          <div>7×24 优先工单支持</div>\n        </div>\n        <div class=\"plan-cta\">\n          <a href=\"#\">按月订阅</a>\n        </div>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-name\">\n          <h3>团队版</h3>\n          <div class=\"price\">¥85 / 月</div>\n          <div class=\"annual\">按年付仅需 ¥850 / 年</div>\n        </div>\n        <div class=\"plan-features\">\n          <div>每月 1000GB 流量额度</div>\n          <div>支持 20 台设备同时在线</div>\n          <div>VIP 专属高带宽节点</div>\n          <div>支持企业定制路由</div>\n          <div>专属客户经理服务</div>\n        </div>\n        <div class=\"plan-cta\">\n          <a href=\"#\">按月订阅</a>\n        </div>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"clients\">\n  <div class=\"wrap\">\n    <div class=\"block-title\">\n      <span class=\"num\">§ 五</span>\n      <h2>客户端:它把夜煞戴在你设备的哪一侧</h2>\n      <span class=\"line\"></span>\n    </div>\n    <p>夜煞本身不发布独立客户端,而是通过通用的代理协议与第三方开源客户端协作。选择客户端时,请先确认设备系统与你的使用习惯,再决定是否启用全部功能模块。</p>\n\n    <div class=\"clients-list\">\n      <article class=\"client\">\n        <h4>桌面端通用协议客户端</h4>\n        <div class=\"sys\">Windows · macOS · Linux</div>\n        <p>适合日常写稿与研究,通过订阅链接自动同步节点分组;支持系统代理、分应用代理与 TUN 模式,默认仅开启系统代理以减少干扰。</p>\n      </article>\n      <article class=\"client\">\n        <h4>命令行节点测速工具</h4>\n        <div class=\"sys\">终端 · 跨平台</div>\n        <p>适合需要在脚本里嵌入测速环节的用户,提供与夜煞订阅格式兼容的延迟与丢包率统计输出,可写入定时任务。</p>\n      </article>\n      <article class=\"client\">\n        <h4>移动端轻量客户端</h4>\n        <div class=\"sys\">iOS · Android</div>\n        <p>适合只在通勤或差旅途中开启的场景,默认关闭流量统计上报,所有路由决策保留在本机;建议在系统设置中关闭后台刷新以省电。</p>\n      </article>\n      <article class=\"client\">\n        <h4>路由器固件支持</h4>\n        <div class=\"sys\">OpenWrt · iKuaiOS</div>\n        <p>适合希望整屋设备共享同一份线路配置的用户,需要具备一定路由器后台经验;夜煞提供订阅转换示例,不直接提供固件。</p>\n      </article>\n    </div>\n\n    <p>说明:本页不直接提供下载链接地址,所有客户端均来自各自的开源项目页面。请在下载前核对项目名称、版本号与签名信息,这是出于对设备安全的基本尊重。</p>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"block-title\">\n      <span class=\"num\">§ 六</span>\n      <h2>常见问题:按主题分组,而不是按字数排序</h2>\n      <span class=\"line\"></span>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>关于账单与续费 <span class=\"tag\">— Billing</span></h3>\n\n      <details class=\"faq\">\n        <summary>订单完成后多久能收到节点与凭证?</summary>\n        <div class=\"a\">\n          <p>绝大多数订单在完成支付后的数分钟内自动开通,节点与订阅链接将出现在你的账户页面内。</p>\n          <p>若在半小时内仍未收到,请检查邮件垃圾箱,或在工单系统里提交订单号与支付截图,客服会在工作日按先后顺序处理。</p>\n        </div>\n      </details>\n\n      <details class=\"faq\">\n        <summary>套餐之间的差异是什么,可以中途升级吗?</summary>\n        <div class=\"a\">\n          <p>三档套餐的差异主要体现在每月流量额度、同时在线设备数,以及是否包含 IPLC 专线与专属客户经理服务。</p>\n          <p>可以在任意时间从低档升级到高档,差价按当月剩余天数折算;降档则在下个计费周期生效,以避免在周期内出现权益回退。</p>\n        </div>\n      </details>\n\n      <details class=\"faq\">\n        <summary>支持哪些支付方式,是否提供发票?</summary>\n        <div class=\"a\">\n          <p>支持常见的在线支付方式。具体可用渠道以结算页面显示为准。</p>\n          <p>个人用户可申请普通电子发票,企业用户请在订单备注中提供抬头与税号,审核通过后将以邮件形式送达。</p>\n        </div>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>关于使用与兼容 <span class=\"tag\">— Usage</span></h3>\n\n      <details class=\"faq\">\n        <summary>夜煞同时支持哪些设备与系统?</summary>\n        <div class=\"a\">\n          <p>夜煞通过通用协议工作,理论上兼容任何遵循该协议的开源客户端。在常见系统中均能找到对应方案,具体客户端名单可在\"客户端\"一节查阅。</p>\n          <p>对于电视盒子、定制系统或老旧设备,建议先在工单中描述使用场景,以避免不必要的尝试成本。</p>\n        </div>\n      </details>\n\n      <details class=\"faq\">\n        <summary>是否会影响本地局域网内的其他设备?</summary>\n        <div class=\"a\">\n          <p>默认情况下,代理仅作用于开启客户端的设备本身,不会改变家庭或办公网络中其他设备的网络行为。</p>\n          <p>如果你希望全屋共享同一份线路,请参考路由器固件支持的说明,并自行评估由此带来的带宽分配变化。</p>\n        </div>\n      </details>\n\n      <details class=\"faq\">\n        <summary>是否会记录访问日志?</summary>\n        <div class=\"a\">\n          <p>夜煞不在业务侧记录访问内容、目标域名或访问时间戳。出于计费与风控需要,仅保留最少必要的连接信息,且保留期限以本页为准,不向第三方共享。</p>\n          <p>请注意,设备本机是否记录访问历史,取决于你所选择的客户端,而非夜煞服务本身。</p>\n        </div>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>关于停服与争议 <span class=\"tag\">— Service</span></h3>\n\n      <details class=\"faq\">\n        <summary>可以随时取消订阅吗,会退还剩余费用吗?</summary>\n        <div class=\"a\">\n          <p>按月订阅可随时在下一个续费日前取消,本周期内已开通的线路不会因取消而中断,直至本周期自然结束。</p>\n          <p>按年订阅如在开通后 7 日内未实际使用流量,可申请按比例退还;已实际使用的部分,将按当月套餐价格折算扣除。</p>\n        </div>\n      </details>\n\n      <details class=\"faq\">\n        <summary>如果某个节点长时间不可用,如何获得补偿?</summary>\n        <div class=\"a\">\n          <p>请在工单中提供节点编号、不可用的起止时间与大致地区。核实后,将按不可用时长折算为流量额度返还至账户,不再单独发放现金补偿。</p>\n          <p>整条线路级别的中断将另行公告,并按中断时长提供统一补偿方案。</p>\n        </div>\n      </details>\n\n      <details class=\"faq\">\n        <summary>出现账号被盗或凭证泄露怎么办?</summary>\n        <div class=\"a\">\n          <p>请立即在工单中提交账号申诉,提供必要的身份核验信息后,夜煞将冻结该账号下的所有活跃会话,并协助重置凭证。</p>\n          <p>冻结期间已开通的线路将暂停,直至核验完成。建议平时启用客户端自带的本地加密,避免将订阅链接明文保存在云笔记中。</p>\n        </div>\n      </details>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"epilogue\">\n  <div class=\"wrap\">\n    <div class=\"block-title\">\n      <span class=\"num\">§ 末</span>\n      <h2>写在最后:港在,灯在</h2>\n      <span class=\"line\"></span>\n    </div>\n    <div class=\"column\">\n      <p>夜煞不是一份关于速度的产品,它更像是一份关于节奏的承诺。当夜幕拉低,大多数人合上屏幕,留下来的那部分人需要的是一条不会在关键时刻掉链子的线路,而不是一段惊艳的演示。</p>\n      <p>如果你也是这其中的一员,欢迎在合适的时刻选择一档合适的套餐,把夜间的航行交给夜煞。我们不会用花哨的形容词去追逐你,但会在你真正需要的时候,把灯挂得再稳一些。</p>\n      <div class=\"pull\">港在,灯在。来去之间,请自便。</div>\n    </div>\n  </div>\n</section>\n\n</main>\n\n\n<nav class=\"bottom-nav\" aria-label=\"底部导航\">\n  <div class=\"wrap\">\n    <span class=\"label\">HiccupPort</span>\n    <a href=\"#prologue\">缘起</a>\n    <a href=\"#audience\">适用</a>\n    <a href=\"#howto\">步骤</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">FAQ</a>\n    <span class=\"spacer\"></span>\n    <a class=\"cta\" href=\"#plans\">订阅夜煞</a>\n  </div>\n</nav>\n\n<footer class=\"foot\">\n  <div class=\"wrap\">\n    <div>夜煞 (HiccupPort) — 一份长期记录的夜间航标</div>\n    <div class=\"small\">本页所述套餐、权益与服务条款以最新版本为准 · 不构成广告或邀约</div>\n  </div>\n</footer>",
